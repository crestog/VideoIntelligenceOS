# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store

# Runtime artifacts (never commit data or services)
neo4j-community-*/
neo4j.tar.gz
qdrant_storage/
Insta-Vault/
huggingface_cache/
cloudflared
setup_logs.txt
__pycache__/
*.pyc
*.pyo

# Redis persistence — AOF is disabled (boot.py runs Redis in-memory), but if a
# stray redis-server ever writes one, it must never enter the object store.
# A committed AOF is what broke the Kaggle boot: git's CRLF normalization
# corrupted the RESP framing and Redis refused to start. See .gitattributes.
appendonly.aof
appendonlydir/
dump.rdb

# Databases / session state
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.session
*.session-journal

# The local data home, when ATLAS_DATA is unset and _paths() falls back to a
# repo-relative directory. It is rebuildable from the channel and it is large:
# a run of vsearch.build() on thirty reels put 238 MB of frame matrices here,
# and only the *.db patterns above stood between that and a commit. So ignore
# the directory *and* the matrix extensions, because the fallback path is not
# the only place they can land.
atlas_data/
*.vec
*.ids
*.vec.json